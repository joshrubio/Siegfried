# Supabase (Postgres + pgvector) — local dev y producción apuntan a la misma instancia
# Formato de API keys nuevo de Supabase (no las legacy JWT anon/service_role,
# que Supabase está deprecando — ver vault/decisions/2026-10-07-supabase-key-format.md)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Modelo usado para generar embeddings del vault
VOYAGE_API_KEY=
