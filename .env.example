# Supabase (Postgres + pgvector) — local dev and production point at the same instance
# New Supabase API key format (not the legacy JWT anon/service_role keys,
# which Supabase is deprecating — see vault/decisions/2026-10-07-supabase-key-format.md)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Model used to generate vault embeddings
VOYAGE_API_KEY=
